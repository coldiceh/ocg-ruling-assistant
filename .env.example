# Card/rule evidence preparation remains pinned to DeepSeek V4 Flash. Relay
# Sol/Terra/Luna are evaluated in the isolated admin lab first; configuring a
# relay key does not change the public final model. PUBLIC_RULING_MODEL_PROFILE
# remains an explicit operator choice after evaluation.
PUBLIC_RULING_MODEL_PROFILE=deepseek-v4-flash-high
ADMIN_MODEL_LAB_ENABLED=false
# Admin-session-only experiment override. When true, paid lab runs skip the
# ADMIN_FINAL_BUDGET_* reservation pools but still retain provider usage/cost
# metering in each run. It is stripped from the public answer environment.
ADMIN_MODEL_LAB_BYPASS_DAILY_BUDGET=false
# Optional: enable this only when an OpenAI key is available. Domestic-model
# experiments do not require it.
ADMIN_OPENAI_ENABLED=false
ADMIN_MODEL_LAB_LIMITS_ENABLED=false

# Server-owned credentials. Never expose these in browser configuration.
ADMIN_SESSION_PASSWORD=
ADMIN_ALLOWED_ORIGINS=https://coldiceh.github.io
# Public answer API CORS allowlist (one exact Origin value).
ALLOWED_ORIGIN=https://coldiceh.github.io
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional third-party relay credential for the isolated admin model lab. This
# is not an OpenAI credential or an OpenAI-authenticated endpoint. Use only a
# key issued by the relay, keep it server-side, and never put it in config.json.
# Required together; the endpoint is intentionally not committed as a default.
RELAY_API_KEY=
RELAY_BASE_URL=
# RELAY_MAX_COMPLETION_TOKENS=8192
# Relay final rulings stream by default so long reasoning does not wait for one
# complete JSON response behind Cloudflare. Keep this server-side.
RELAY_STREAM=true
# This is the application's end-to-end stream guard, not Cloudflare's first-byte
# timeout. The relay/reverse proxy must flush SSE headers and chunks promptly.
RELAY_STREAM_TIMEOUT_MS=700000
# Current token-group multiplier from the user-provided 2026-08-07 screenshot.
# Set this server-side in Vercel. It is optional because the versioned pricing
# dataset has the same default, but any other token group must provide its own
# value (strictly greater than 0 and at most 1) or update the pricing dataset.
RELAY_PRICING_MULTIPLIER=0.27
# Relay pricing/identity cannot be verified by this application. Local relay
# models each use a 10 CNY pool and reserve 5 CNY before transport. Completed calls
# with reliable usage are estimated from versioned dashboard-screenshot rates;
# verify those rates and set a hard limit in the relay account before spending.
# RELAY_ESTIMATED_CNY_PER_CALL is only an explicit matrix override and has no
# safe default.
# RELAY_ESTIMATED_CNY_PER_CALL=
# ADMIN_MATRIX_ESTIMATED_INPUT_TOKENS=32000
# ADMIN_MATRIX_ESTIMATED_OUTPUT_TOKENS=8192
# Budget conversion factor used to convert versioned USD estimates into the CNY
# reservation ledger. Recheck it before paid runs; this is not a live FX feed.
# ADMIN_MODEL_LAB_USD_TO_CNY_RATE=7.5
# ADMIN_MODEL_LAB_EXCHANGE_RATE_VERSION=pilot-budget-factor-v1
# Relay is not registered as a public ruling profile. It remains admin-only even
# when RELAY_API_KEY is configured.

# Optional admin evidence-preparation providers. These secrets and endpoints
# are server-owned; the admin browser may select only allowlisted model IDs.
GLM_API_KEY=
KIMI_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ADMIN_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ADMIN_KIMI_BASE_URL=https://api.moonshot.cn/v1
# ADMIN_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Public API budget. The existing total pool remains the hard aggregate guard;
# the four optional bucket limits do not increase it. Leaving a bucket limit
# blank records separate spend without adding another cap.
API_DAILY_BUDGET_CNY=10
API_BUDGET_TIMEZONE=Asia/Shanghai
API_BUDGET_MODE=hard
# API_EVIDENCE_DAILY_BUDGET_CNY=
# API_GLM_FINAL_DAILY_BUDGET_CNY=
# API_DEEPSEEK_FINAL_DAILY_BUDGET_CNY=
# API_RELAY_FINAL_DAILY_BUDGET_CNY=
# Official defaults as of 2026-08-03; override if provider pricing changes.
GLM_INPUT_CNY_PER_MTOK=8
GLM_OUTPUT_CNY_PER_MTOK=28
GLM_CACHE_HIT_INPUT_CNY_PER_MTOK=2
# Synchronous compatible final calls fail closed after this server timeout and
# are never automatically retried because the upstream billing outcome may be unknown.
# Keep Relay's own stream timeout lower so budget settlement and persistence have
# time to finish before this outer guard and the admin function's 800-second limit.
ADMIN_MODEL_LAB_SYNC_FINAL_TIMEOUT_MS=740000

# Admin paid-call budget reservations are persistent. DeepSeek evidence
# preparation and DeepSeek Flash/Pro final rulings share one pool; Relay
# Sol/Terra/Luna each have a separate model pool.
# No pool is enabled by default: both values for a pool must be set before its
# real model can be called. DeepSeek preparation/Flash/Pro share `DEEPSEEK`;
# relay Sol/Terra/Luna use `RELAY_SOL`, `RELAY_TERRA`, and `RELAY_LUNA`.
# The reservation is held on unknown
# pricing, timeout, 429/5xx, or ambiguous acknowledgement; only an explicit
# pre-acceptance rejection releases it.
ADMIN_FINAL_BUDGET_TIMEZONE=Asia/Shanghai
# ADMIN_FINAL_BUDGET_DEEPSEEK_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_DEEPSEEK_RESERVATION_CNY=2
# ADMIN_FINAL_BUDGET_RELAY_SOL_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_RELAY_SOL_RESERVATION_CNY=5
# ADMIN_FINAL_BUDGET_RELAY_TERRA_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_RELAY_TERRA_RESERVATION_CNY=5
# ADMIN_FINAL_BUDGET_RELAY_LUNA_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_RELAY_LUNA_RESERVATION_CNY=5
# ADMIN_FINAL_BUDGET_GLM_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_GLM_RESERVATION_CNY=10
# ADMIN_FINAL_BUDGET_KIMI_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_KIMI_RESERVATION_CNY=10
# ADMIN_FINAL_BUDGET_OPENAI_DAILY_CNY=10
# ADMIN_FINAL_BUDGET_OPENAI_RESERVATION_CNY=10
# ADMIN_FINAL_BUDGET_REDIS_TIMEOUT_MS=2000
# ADMIN_FINAL_BUDGET_TTL_SECONDS=259200
# ADMIN_FINAL_BUDGET_REDIS_KEY_PREFIX=admin-final-budget:v1

# Versioned DeepSeek V4 pricing used to settle reported usage. These official
# CNY rates were checked on 2026-08-06; recheck before a paid run because the
# provider may change them. Generic legacy DeepSeek rates remain supported for
# Flash only; Pro is deliberately unpriced unless its model-specific rates are
# configured, in which case its conservative reservation remains charged.
# ADMIN_MODEL_LAB_DEEPSEEK_PRICING_VERSION=deepseek-official-cny-2026-08-06
# ADMIN_MODEL_LAB_DEEPSEEK_PRICING_EFFECTIVE_DATE=2026-08-06
# ADMIN_MODEL_LAB_DEEPSEEK_FLASH_CACHED_INPUT_CNY_PER_MTOK=0.02
# ADMIN_MODEL_LAB_DEEPSEEK_FLASH_INPUT_CNY_PER_MTOK=1
# ADMIN_MODEL_LAB_DEEPSEEK_FLASH_OUTPUT_CNY_PER_MTOK=2
# ADMIN_MODEL_LAB_DEEPSEEK_PRO_CACHED_INPUT_CNY_PER_MTOK=0.025
# ADMIN_MODEL_LAB_DEEPSEEK_PRO_INPUT_CNY_PER_MTOK=3
# ADMIN_MODEL_LAB_DEEPSEEK_PRO_OUTPUT_CNY_PER_MTOK=6

# Adjacent OCG engine. The legacy /simulate path remains non-authoritative.
OCG_ENGINE_URL=
OCG_ENGINE_TOKEN=
RAG_AUTO_ENGINE_SIMULATION=false

# Optional legacy-Lua semantic discovery. When OCG_ENGINE_URL is configured,
# the assistant reads locked c{passcode}.lua resources through versioned engine
# endpoints and gives the final model only a bounded operation/dependency view.
# It is discovery-only: it never becomes official evidence and its public
# verdict always remains UNKNOWN. All limits are per ruling request.
RAG_LEGACY_LUA_TIMEOUT_MS=5000
RAG_LEGACY_LUA_MAX_CARDS=8
RAG_LEGACY_LUA_MAX_CANDIDATES=48
RAG_LEGACY_LUA_MAX_BYTES=196608
RAG_LEGACY_LUA_MAX_HTTP_RESPONSE_BYTES=2097152
# ADMIN_MODEL_LAB_LEGACY_LUA_TIMEOUT_MS=5000
# ADMIN_MODEL_LAB_LEGACY_LUA_MAX_BYTES=196608

# Formal rules are opt-in shadow evidence. Until the adjacent engine exposes
# both formal endpoints and a compatible public proof verifier, results stay
# typed UNKNOWN and the normal evidence-based answer path remains available.
RAG_FORMAL_ENGINE_MODE=off
# Before any formal network/model work, production must inject an independent
# scenario-completeness verifier and public proof verifier. The default draft
# extractor then runs only after formal capabilities and immutable definition
# bindings pass. Its output remains non-authoritative until verification.
RAG_FORMAL_SCENARIO_DRAFT_MODEL=deepseek-v4-flash
RAG_FORMAL_SCENARIO_DRAFT_MAX_OUTPUT_TOKENS=3200
RAG_FORMAL_SCENARIO_DRAFT_TIMEOUT_MS=15000
RAG_FORMAL_SCENARIO_DRAFT_THINKING_MODE=disabled
# Required in formal-shadow mode. The verifier receipt must match both values;
# leaving either blank fails closed before capabilities or paid draft extraction.
RAG_FORMAL_SCENARIO_DRAFT_VERIFIER_ID=
RAG_FORMAL_SCENARIO_DRAFT_VERIFIER_VERSION=
# RAG_FORMAL_SCENARIO_DRAFT_REASONING_EFFORT=high
OCG_FORMAL_EXPECTED_ENGINE_VERSION=
OCG_FORMAL_EXPECTED_IR_VERSION=
OCG_FORMAL_EXPECTED_RULESET_VERSION=
OCG_FORMAL_EXPECTED_SCHEMA_VERSION=ocg-formal-engine/v1
OCG_FORMAL_EXPECTED_PROOF_VERIFIER_VERSION=ocg-proof-verifier/v1

# Production persistence. Memory storage is test-only and must not be used as a
# production fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_SESSION_STORAGE=redis
ADMIN_RUN_STORAGE=redis
ADMIN_LAB_RECORD_STORAGE=redis

# Optional prefixes and timeouts.
ADMIN_SESSION_REDIS_PREFIX=admin-session:v1
ADMIN_RUN_REDIS_KEY_PREFIX=admin-runs:v1
ADMIN_LAB_RECORD_REDIS_KEY_PREFIX=admin-lab-records:v1
ADMIN_SESSION_TTL_SECONDS=900
ADMIN_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_RUN_REDIS_TIMEOUT_MS=5000
ADMIN_LAB_RECORD_REDIS_TIMEOUT_MS=1800
# Full Evidence Snapshots are stored as deterministic gzip+base64 envelopes.
# These optional fail-closed limits apply before and after compression;
# defaults are 32 MiB uncompressed and 16 MiB compressed. They do not migrate
# or delete legacy uncompressed records already stored in Upstash.
# ADMIN_RUN_SNAPSHOT_MAX_UNCOMPRESSED_BYTES=33554432
# ADMIN_RUN_SNAPSHOT_MAX_COMPRESSED_BYTES=16777216
# Successful public answers can publish a rolling average of the latest 20
# samples. It reuses the configured Upstash REST database and never blocks an
# answer when storage is unavailable.
PUBLIC_ANSWER_LATENCY_ENABLED=true
PUBLIC_ANSWER_LATENCY_WINDOW_SIZE=20
PUBLIC_ANSWER_LATENCY_RETENTION_DAYS=30
PUBLIC_ANSWER_LATENCY_REDIS_TIMEOUT_MS=1200
# Full admin experiment state and evidence expire after 30 days by default;
# set to none only if permanent retention is intentionally required.
# ADMIN_RUN_TTL_SECONDS=2592000
# Lightweight admin history keeps the newest 100 entries by default.
# ADMIN_LAB_RECORD_MAX_ENTRIES=100

# Paid real-model calls are intentionally not part of the default test suite.
# Keep ADMIN_MODEL_LAB_ENABLED=false until an administrator explicitly approves
# a manual paid experiment and configures the relevant server-side credentials.
