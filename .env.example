# Public answering remains unchanged. The admin model lab is disabled unless
# both switches below are explicitly enabled on the server.
ADMIN_MODEL_LAB_ENABLED=false
ADMIN_OPENAI_ENABLED=false
ADMIN_MODEL_LAB_LIMITS_ENABLED=false

# Required only when the admin model lab is deliberately enabled.
ADMIN_SESSION_PASSWORD=
ADMIN_ALLOWED_ORIGINS=https://coldiceh.github.io
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Adjacent OCG engine. The legacy /simulate path remains non-authoritative.
OCG_ENGINE_URL=
OCG_ENGINE_TOKEN=
RAG_AUTO_ENGINE_SIMULATION=false

# Formal rules are opt-in shadow evidence. Until the adjacent engine exposes
# both formal endpoints and a compatible public proof verifier, results stay
# typed UNKNOWN and the normal evidence-based answer path remains available.
RAG_FORMAL_ENGINE_MODE=off
OCG_FORMAL_EXPECTED_ENGINE_VERSION=
OCG_FORMAL_EXPECTED_IR_VERSION=
OCG_FORMAL_EXPECTED_RULESET_VERSION=
OCG_FORMAL_EXPECTED_SCHEMA_VERSION=ocg-formal-engine/v1
OCG_FORMAL_EXPECTED_PROOF_VERIFIER_VERSION=ocg-proof-verifier/v1

# Compatibility-only escape hatch. Keep false in production: local regex and
# heuristic analyzers may provide evidence, but must not skip the final model.

# Production persistence. Memory storage is test-only and must not be used as a
# production fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_SESSION_STORAGE=redis
ADMIN_RUN_STORAGE=redis
ADMIN_LAB_RECORD_STORAGE=redis

# Optional prefixes and timeouts.
ADMIN_SESSION_REDIS_PREFIX=admin-session:v1
ADMIN_RUN_REDIS_KEY_PREFIX=admin-runs:v1
ADMIN_LAB_RECORD_REDIS_KEY_PREFIX=admin-lab-records:v1
ADMIN_SESSION_TTL_SECONDS=900
ADMIN_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_RUN_REDIS_TIMEOUT_MS=1800
ADMIN_LAB_RECORD_REDIS_TIMEOUT_MS=1800

# Paid real-model calls are intentionally not part of the default test suite.
# Keep the two enable switches false until an administrator explicitly approves
# a manual paid experiment and configures server-side credentials.
