{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "RELAY_STREAM_TIMEOUT_MS": "270000",
    "ADMIN_MODEL_LAB_SYNC_FINAL_TIMEOUT_MS": "290000",
    "ADMIN_MODEL_LAB_BYPASS_DAILY_BUDGET": "true",
    "ADMIN_RUN_TTL_SECONDS": "604800",
    "ADMIN_LAB_RECORD_MAX_ENTRIES": "1000",
    "ADMIN_MODEL_LAB_MAINTENANCE_DISABLED": "true"
  },
  "functions": {
    "api/answer.js": {
      "maxDuration": 300,
      "includeFiles": "data/legacy-lua-semantic-cache-v2/**"
    },
    "api/admin-model-lab.js": {
      "maxDuration": 300,
      "includeFiles": "data/legacy-lua-semantic-cache-v2/**"
    },
    "api/admin-frozen-deepseek.js": {
      "maxDuration": 300
    }
  }
}
